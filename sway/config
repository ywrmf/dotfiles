# ~/.config/sway/config
# Converted from the uploaded Hyprland config.
# Target: Sway 1.11+ syntax

### Programs ###
set $mod Mod4
set $terminal ghostty
set $fileManager dolphin
set $menu fuzzel

### Output ###
# Original Hyprland monitor: DP-1,2560x1440@239.970,0x0,1
output DP-1 {
    mode 2560x1440@239.970Hz
    position 0 0
    scale 1
    bg /home/aperic/Pictures/Wallpapers/arch.png fill
    allow_tearing no
}

### Session / portals / input method ###
# Sway cannot fully replace Hyprland's `env = KEY,VALUE` from inside the config.
# Put the companion file `90-sway-env.conf` into ~/.config/environment.d/ and re-login.
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XMODIFIERS QT_IM_MODULE QT_IM_MODULES SDL_IM_MODULE GTK_IM_MODULE LANG LC_CTYPE XCURSOR_SIZE
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XMODIFIERS QT_IM_MODULE QT_IM_MODULES SDL_IM_MODULE GTK_IM_MODULE LANG LC_CTYPE XCURSOR_SIZE
exec fcitx5 -d --replace

### Autostart ###
exec waybar -c ~/.config/waybar/config-simple -s ~/.config/waybar/style-simple.css
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

### Look and feel ###
# Hyprland blur / animations / shadows / rounded corners are not native Sway features.
default_border pixel 2
default_floating_border pixel 2
gaps inner 5
gaps outer 20
smart_gaps off
smart_borders off
hide_edge_borders none
font pango:monospace 10

# Approximation of Hyprland active/inactive border colors.
client.focused          #6E508F #6E508F #ffffff #61508F #6E508F
client.focused_inactive #2a2c38 #2a2c38 #888888 #2a2c38 #2a2c38
client.unfocused        #2a2c38 #2a2c38 #888888 #2a2c38 #2a2c38
client.urgent           #900000 #900000 #ffffff #900000 #900000

### Layout behavior ###
default_orientation auto
workspace_layout default
focus_follows_mouse yes
focus_wrapping yes
tiling_drag enable
floating_modifier $mod normal
xwayland enable

### Input ###
input type:keyboard {
    xkb_layout us
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

input type:touchpad {
    accel_profile flat
    pointer_accel 0
    natural_scroll disabled
}

# Your Hyprland device rule. If it does not apply in Sway, get the real name with:
# swaymsg -t get_inputs
input "epic-mouse-v1" {
    accel_profile flat
    pointer_accel -0.5
}

### Gestures ###
# Approximation of Hyprland: gesture = 3, horizontal, workspace
bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output

### Keybindings ###
bindsym $mod+t exec $terminal
bindsym $mod+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Exit' 'swaymsg exit'
bindsym $mod+e exec $fileManager
bindsym $mod+v floating toggle
bindsym $mod+r exec $menu

# Hyprland pseudo tiling has no real Sway equivalent.
bindsym $mod+p nop pseudo tiling is Hyprland-only

# Approximation of Hyprland dwindle togglesplit.
bindsym $mod+j split toggle

# Clipboard history.
bindsym $mod+Shift+v exec sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'

# Move focus with Super + arrow keys.
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Workspaces.
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+Left workspace prev_on_output
bindsym $mod+Shift+Right workspace next_on_output

# Sway scratchpad approximation of Hyprland special workspace.
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# Scroll through workspaces with Super + mouse wheel.
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

### Multimedia keys ###
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

### Window rules ###
# Hyprland's suppress maximize event rule has no direct Sway equivalent.
# XWayland empty-class floating drag workaround approximation.
no_focus [class="^$" title="^$" shell="xwayland" floating]

# Kept from original, though hyprland-run itself is obviously Hyprland-specific.
for_window [app_id="hyprland-run"] floating enable, move position 20 1320
for_window [class="hyprland-run"] floating enable, move position 20 1320
